generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model SaveSlot {
  slot       Int      @id
  version    Int      @default(1)
  seed       String
  day        Int
  checksum   String
  compressed Bytes
  updatedAt  DateTime @updatedAt
}
