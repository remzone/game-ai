PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://rpg:localdev@localhost:5432/rpg?schema=public
POSTGRES_PASSWORD=localdev
# postgres for Docker/production; file for standalone local development
STORAGE_DRIVER=postgres
SAVE_DIRECTORY=./data
# Optional; key stays on the server. AI is disabled by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional locally. Required if exposing the server beyond localhost.
GAME_PASSWORD=
PUBLIC_ORIGIN=http://localhost:3000
